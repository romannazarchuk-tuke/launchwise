# Reference copy — installed at /etc/systemd/system/launchwise-api.service
[Unit]
Description=LaunchWise API (FastAPI via uvicorn)
After=network.target mariadb.service
Wants=mariadb.service

[Service]
Type=simple
User=launchwise
Group=launchwise
WorkingDirectory=/srv/launchwise/backend
EnvironmentFile=/srv/launchwise/backend/.env
ExecStart=/srv/launchwise/backend/.venv/bin/uvicorn app.main:app --host 127.0.0.1 --port 8000 --workers 2 --proxy-headers --forwarded-allow-ips 127.0.0.1
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
