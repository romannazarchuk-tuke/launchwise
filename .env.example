# LaunchWise settings for local development. Copy to .env (git-ignored) and adjust.

# --- MariaDB in Docker (docker compose) ---
MARIADB_ROOT_PASSWORD=change-me-root
MARIADB_DATABASE=launchwise
MARIADB_USER=launchwise
MARIADB_PASSWORD=change-me
# Host port for the database (3307 avoids clashing with a locally installed MySQL/MariaDB)
MARIADB_PORT=3307

# --- Backend (FastAPI) --- required. Must match the MARIADB_* values above.
DATABASE_URL=mysql+pymysql://launchwise:change-me@127.0.0.1:3307/launchwise?charset=utf8mb4

# FreeSerp example sites. No API key exists or is needed.
# false = no outside requests; the Examples tab then shows its empty state.
FREESERP_ENABLED=true
# FREESERP_URL=https://freeserp.ai/api.php

# --- Frontend (Vite) ---
# Public address of the site, used for canonical and Open Graph links in index.html
VITE_SITE_URL=http://localhost:5173
# Where the Vite dev server forwards /api requests
VITE_API_PROXY_TARGET=http://127.0.0.1:8000
